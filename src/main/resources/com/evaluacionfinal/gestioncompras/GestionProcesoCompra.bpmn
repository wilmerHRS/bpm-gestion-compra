    <bpmn2:scriptTask id="_preparar" name="Preparar consulta" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Preparar consulta]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_f2</bpmn2:incoming>
      <bpmn2:outgoing>_f3</bpmn2:outgoing>
      <bpmn2:script><![CDATA[if (email == null || email.trim().isEmpty()) {
    throw new IllegalArgumentException("No se recibio el correo de Registrar solicitud.");
}
email = email.trim();
if (!email.matches("^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}$")) {
    throw new IllegalArgumentException("El correo recibido no tiene un formato valido.");
}
kcontext.setVariable("email", email);
Solicitud datos = new Solicitud();
datos.setProductoId(productoId);
datos.setCantidad(cantidad);
datos.setEmail(email);
datos.setMotivo(motivo);
datos.setEncontrado(Boolean.FALSE);
datos.setRuta("PENDIENTE");
kcontext.setVariable("solicitud", datos);
String base = System.getProperty("compras.catalogo.url", "https://dummyjson.com/products");
kcontext.setVariable("urlProducto", base.replaceAll("/+$", "") + "/" + (productoId == null ? 0 : productoId));]]></bpmn2:script>
    </bpmn2:scriptTask>
