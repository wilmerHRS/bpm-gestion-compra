    <bpmn2:sequenceFlow id="_f8" name="Rechazar" sourceRef="_ruta" targetRef="_merge2">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Rechazar]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_afDpAM8IEfGL3uoOHcb35Q" language="http://www.java.com/java"><![CDATA[return "RECHAZAR".equals(solicitud.getRuta());]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_f10" name="Total mayor a S/ 500" sourceRef="_ruta" targetRef="_aprobar">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Total mayor a S/ 500]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_afDpAc8IEfGL3uoOHcb35Q" language="http://www.java.com/java"><![CDATA[return "APROBACION".equals(solicitud.getRuta());]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_f17" sourceRef="_rechazo" targetRef="_merge3"/>
    <bpmn2:sequenceFlow id="_fm2" sourceRef="_merge2" targetRef="_rechazo"/>
    <bpmn2:sequenceFlow id="_f9" name="Total hasta S/ 500" sourceRef="_ruta" targetRef="_merge1">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Total hasta S/ 500]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_afDpAs8IEfGL3uoOHcb35Q" language="http://www.java.com/java"><![CDATA[return "DIRECTA".equals(solicitud.getRuta());]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_f5" sourceRef="_leer" targetRef="_reglas"/>
    <bpmn2:sequenceFlow id="_f11" sourceRef="_aprobar" targetRef="_decision"/>
    <bpmn2:sequenceFlow id="_fm3" sourceRef="_merge3" targetRef="_correoDatos"/>
    <bpmn2:sequenceFlow id="_fm1" sourceRef="_merge1" targetRef="_orden"/>
    <bpmn2:sequenceFlow id="_f16" sourceRef="_registrar" targetRef="_merge3"/>
    <bpmn2:sequenceFlow id="_f15" sourceRef="_orden" targetRef="_registrar"/>
    <bpmn2:sequenceFlow id="_f14" name="No" sourceRef="_aprobada" targetRef="_merge2">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[No]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_afDpA88IEfGL3uoOHcb35Q" language="http://www.java.com/java"><![CDATA[return Boolean.FALSE.equals(aprobada);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_f13" name="Si" sourceRef="_aprobada" targetRef="_merge1">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Si]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_afDpBM8IEfGL3uoOHcb35Q" language="http://www.java.com/java"><![CDATA[return Boolean.TRUE.equals(aprobada);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="_f12" sourceRef="_decision" targetRef="_aprobada"/>
    <bpmn2:sequenceFlow id="_f4" sourceRef="_rest" targetRef="_leer"/>
    <bpmn2:sequenceFlow id="_f3" sourceRef="_preparar" targetRef="_rest"/>
    <bpmn2:sequenceFlow id="_f18" sourceRef="_correoDatos" targetRef="_email"/>
    <bpmn2:sequenceFlow id="_f19" sourceRef="_email" targetRef="_fin"/>
    <bpmn2:scriptTask id="_retirar" name="Preparar resumen" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Preparar resumen]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_f6</bpmn2:incoming>
      <bpmn2:outgoing>_f20</bpmn2:outgoing>
      <bpmn2:script><![CDATA[String producto = solicitud.getProducto() != null ? solicitud.getProducto() : "No encontrado (id " + solicitud.getProductoId() + ")";
String cantidadTexto = solicitud.getCantidad() != null ? String.valueOf(solicitud.getCantidad()) : "-";
String totalTexto = solicitud.getTotal() != null ? "S/ " + solicitud.getTotal() : "-";
String motivoTexto = solicitud.getMotivo() != null && !solicitud.getMotivo().trim().isEmpty() ? solicitud.getMotivo().trim() : "-";
String detalle = "Producto: " + producto + " | Cantidad: " + cantidadTexto
        + " | Total: " + totalTexto + " | Motivo: " + motivoTexto;
kcontext.setVariable("resumen", detalle);]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:exclusiveGateway id="_ruta" name="Resultado de reglas" gatewayDirection="Diverging">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Resultado de reglas]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_f7</bpmn2:incoming>
      <bpmn2:outgoing>_f9</bpmn2:outgoing>
      <bpmn2:outgoing>_f10</bpmn2:outgoing>
      <bpmn2:outgoing>_f8</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
