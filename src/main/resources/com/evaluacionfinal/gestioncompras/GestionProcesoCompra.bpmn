    <bpmn2:scriptTask id="_leer" name="Procesar respuesta" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Procesar respuesta]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_f4</bpmn2:incoming>
      <bpmn2:outgoing>_f5</bpmn2:outgoing>
      <bpmn2:script><![CDATA[if (Integer.valueOf(404).equals(estadoHttp)) {
    solicitud.setEncontrado(Boolean.FALSE);
} else {
    if (estadoHttp == null || estadoHttp < 200 || estadoHttp >= 300) {
        throw new IllegalStateException("Error del catalogo. HTTP " + estadoHttp);
    }
    if (respuestaRest == null || !(respuestaRest.get("id") instanceof Number)
            || productoId == null || ((Number) respuestaRest.get("id")).intValue() != productoId
            || !(respuestaRest.get("title") instanceof String)
            || !(respuestaRest.get("price") instanceof Number)
            || !(respuestaRest.get("stock") instanceof Number)) {
        throw new IllegalStateException("Respuesta invalida del catalogo.");
    }
    java.math.BigDecimal precio = new java.math.BigDecimal(respuestaRest.get("price").toString());
    int stock = ((Number) respuestaRest.get("stock")).intValue();
    if (precio.signum() < 0 || stock < 0) {
        throw new IllegalStateException("Precio o stock invalido.");
    }
    solicitud.setEncontrado(Boolean.TRUE);
    solicitud.setProducto((String) respuestaRest.get("title"));
    solicitud.setPrecio(precio);
    solicitud.setStock(Integer.valueOf(stock));
    if (cantidad != null) {
        solicitud.setTotal(precio.multiply(java.math.BigDecimal.valueOf(cantidad.longValue())).setScale(2, java.math.RoundingMode.HALF_UP));
    }
}
kcontext.getKieRuntime().insert(solicitud);]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="_decision" name="Validar decision" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Validar decision]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_f11</bpmn2:incoming>
      <bpmn2:outgoing>_f12</bpmn2:outgoing>
      <bpmn2:script><![CDATA[if (aprobada == null) {
    throw new IllegalArgumentException("Debe indicar si aprueba la solicitud.");
}
if (!aprobada.booleanValue()) {
    solicitud.setResultado("RECHAZADA");
    solicitud.setDetalle("Solicitud rechazada por el jefe.");
}]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="_correoDatos" name="Preparar notificacion" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Preparar notificacion]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_fm3</bpmn2:incoming>
      <bpmn2:outgoing>_f18</bpmn2:outgoing>
      <bpmn2:script><![CDATA[String remitenteCorreo = System.getProperty("compras.correo.remitente", System.getProperty("GMAIL_USER", System.getenv("GMAIL_USER")));
if (remitenteCorreo == null || remitenteCorreo.trim().isEmpty()) {
    throw new IllegalStateException("Configure GMAIL_USER en el KIE Server.");
}
String claveCorreo = System.getProperty("GMAIL_APP_PASSWORD", System.getenv("GMAIL_APP_PASSWORD"));
if (claveCorreo == null || claveCorreo.trim().isEmpty()) {
    throw new IllegalStateException("Configure GMAIL_APP_PASSWORD en el KIE Server.");
}
String resultado = String.valueOf(solicitud.getResultado());
String detalleCorreo = String.valueOf(solicitud.getDetalle()).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;");
String resumenCorreo = String.valueOf(resumen).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;");
kcontext.setVariable("remitente", remitenteCorreo);
kcontext.setVariable("asuntoCorreo", "Solicitud de compra - " + resultado);
kcontext.setVariable("cuerpoCorreo", "<h2>Resultado de la solicitud de compra</h2><p>Estado: " + resultado + "</p><p>" + detalleCorreo + "</p><p>" + resumenCorreo + "</p>");]]></bpmn2:script>
    </bpmn2:scriptTask>
